# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
TRUST_PROXY=false

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/khelyard

# Comma-separated frontend origins allowed by CORS
CLIENT_ORIGINS=http://localhost:3000

# Authentication
# Replace every secret with a different cryptographically random value.
# Production secrets must contain at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Registration OTP
OTP_HASH_SECRET=replace-with-a-different-otp-secret-at-least-32-characters
OTP_EXPIRES_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
MAIL_FROM=KhelYard <no-reply@khelyard.com>
